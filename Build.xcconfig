ENTITLEMENTS_VARIANT =
MARKEDITMAC_ENTITLEMENTS = MarkEditMac/Info$(ENTITLEMENTS_VARIANT).entitlements
QUICKLOOKMAC_ENTITLEMENTS = QuickLookMac/Info$(ENTITLEMENTS_VARIANT).entitlements

CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = app.cyan.markedit-dev
REGISTER_APP_GROUPS = NO
OTHER_SWIFT_FLAGS = $(inherited) -enable-experimental-feature AnyAppleOSAvailability

MARKETING_VERSION = 1.35.0
CURRENT_PROJECT_VERSION = 95

#include? "Local.xcconfig"
