{
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types", "./src/@types"],
    "module": "esnext",
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "composite": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strictNullChecks": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "paths": {
      "@codemirror/lang-html": ["./src/@vendor/lang-html"],
      "@codemirror/lang-markdown": ["./src/@vendor/lang-markdown"]
    }
  }
}
