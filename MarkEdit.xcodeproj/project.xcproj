  "targets": [
    {
      "name": "MarkEditMac",
      "id": "870A51A1294700DE0095C7EB",
      "product": "Products/MarkEdit.app",
      "product-type": "application",
      "last-swift-migration": "14.1",
      "specialized-configurations": [
        { "name": "Debug", "file": "Build.xcconfig" },
        { "name": "Release", "file": "Build.xcconfig" },
      ],
      "dependencies": [
        { "kind": "package", "product-name": "SwiftLint", "product-type": "build-tool-plugin" },
        "QuickLookMac",
        "UpdateInstaller",
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Check Entitlements Drift",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/MarkEditMac/Info.entitlements",
            "$(SRCROOT)/MarkEditMac/Info.local.entitlements",
          ],
          "run-on-every-build": true,
          "shell": "/bin/bash",
          "script": [
            "set -euo pipefail",
            "base=\"$SCRIPT_INPUT_FILE_0\"",
            "local_file=\"$SCRIPT_INPUT_FILE_1\"",
            "[ -f \"$local_file\" ] || exit 0",
            "python3 - \"$base\" \"$local_file\" <<'EOF'",
            "import plistlib, sys",
            "",
            "base_path, local_path = sys.argv[1], sys.argv[2]",
            "base = plistlib.load(open(base_path, \"rb\"))",
            "local = plistlib.load(open(local_path, \"rb\"))",
            "",
            "allowed_extras = {\"com.apple.security.application-groups\"}",
            "errors = []",
            "",
            "for k, v in base.items():",
            "  if k not in local:",
            "    errors.append(f\"Missing key in local: {k}\")",
            "  elif local[k] != v:",
            "    errors.append(f\"Value differs for {k}: base={v!r} local={local[k]!r}\")",
            "",
            "for k in local:",
            "  if k not in base and k not in allowed_extras:",
            "    errors.append(f\"Unexpected key in local (not in base, not allow-listed): {k}\")",
            "",
            "for e in errors:",
            "  print(f\"{local_path}:1: error: {e}\")",
            "",
            "sys.exit(1 if errors else 0)",
            "EOF",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed XPC Services",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/XPCServices",
        },
      ],
      "package-product-members": [
        {
          "product-name": "AppKitExtensions",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "DiffKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "ExtensionCore",
          "build-phase": { "build-phase": "frameworks" },
