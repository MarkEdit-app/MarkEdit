        { "path": "<PRODUCTS>/UpdateInstaller.xpc", "id": "87DA0000000000000000E000", "type": "wrapper.xpc-service", "index": false, "target-membership": [ { "build-phase": "MarkEditMac/copy/Embed XPC Services", "header-preservation": "remove-on-copy" } ] },
